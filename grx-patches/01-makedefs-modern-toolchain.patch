 # For SDL driver the executable prefix EP is used to discriminate 
 # between linux X11 and mingw32. Set
@@ -69,11 +69,16 @@
 WIN32_GCC_i386_STATIC = $(SYSTEM_TAG_PREFIX).006
 ANY_GCC_SDL_STATIC    = $(SYSTEM_TAG_PREFIX).008
 
+# GRX predates C99; gcc >= 14 turns implicit declarations, implicit int and
+# incompatible pointer/int conversions into hard errors. -std=gnu89 keeps the
+# old dialect and -fpermissive downgrades those errors back to warnings.
+LEGACY_C = -std=gnu89 -fpermissive
+
 ifdef   DEBUG
-CCOPT = -O2 -fno-strict-aliasing -Wall -g -DDEBUG=$(DEBUG)
+CCOPT = -O2 -fno-strict-aliasing $(LEGACY_C) -Wall -g -DDEBUG=$(DEBUG)
 LDOPT = -g
 else
-CCOPT = -O2 -fno-strict-aliasing -Wall
+CCOPT = -O2 -fno-strict-aliasing $(LEGACY_C) -Wall
 LDOPT = -s
 endif
 
@@ -128,7 +133,11 @@
 # Set the default GRX font path
 #GRX_DEFAULT_FONT_PATH=${datadir}/grx/fonts
 
-# check for i386 or x86_64 build
+# check for i386 or x86_64 build.  -m32/-m64 exist only on x86; aarch64 and
+# the other targets reject them outright, so ask the machine first.  Override
+# with "make UNAME_M=..." when cross compiling.
+UNAME_M := $(shell uname -m)
+ifneq (,$(filter $(UNAME_M),i386 i486 i586 i686 x86_64 amd64))
 ifeq ($(BUILD_X86_64),y)
 CCOPT += -m64
 LDOPT += -m64
@@ -136,6 +145,7 @@
 CCOPT += -m32
 LDOPT += -m32
 endif
+endif
 
 endif
 
@@ -171,15 +181,16 @@
 ifdef GRXVX11
 
 # The X11 base dir on your system
-X11BASE=/usr/X11R6
+X11BASE=/usr
 
 # Add directories with X11 include files here
 X11INCS=-I$(X11BASE)/include
 
 # put X11 required libraries and directories here
 # note: some systems need -lsocket added
-X11LIB=$(X11BASE)/lib
-X11LIBS=-L$(X11LIB) -lX11
+# modern distributions keep libX11 in a multiarch dir already on the default
